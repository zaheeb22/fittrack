<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- This runs FitTrack with MySQL. Database settings are added privately in Eclipse. -->
<launchConfiguration type="org.eclipse.jdt.launching.localJavaApplication">
    <booleanAttribute key="org.eclipse.debug.core.appendEnvironmentVariables" value="true"/>
    <mapAttribute key="org.eclipse.debug.core.environmentVariables">
        <mapEntry key="FITTRACK_BIND_HOST" value="127.0.0.1"/>
        <mapEntry key="FITTRACK_PORT" value="8081"/>
    </mapAttribute>
    <stringAttribute key="org.eclipse.jdt.launching.MAIN_TYPE" value="com.fittrack.app.FitTrackApp"/>
    <stringAttribute key="org.eclipse.jdt.launching.PROGRAM_ARGUMENTS" value="--mysql"/>
    <stringAttribute key="org.eclipse.jdt.launching.PROJECT_ATTR" value="fittrack"/>
    <stringAttribute key="org.eclipse.jdt.launching.WORKING_DIRECTORY" value="${workspace_loc:fittrack}"/>
</launchConfiguration>

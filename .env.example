# Example settings only. FitTrack does not automatically load this file.
# The hosting service supplies these values through its environment settings.
# Password fields are blank so this example contains no real passwords.
FITTRACK_DB_URL=jdbc:mysql://your-private-database-host:3306/your_database
FITTRACK_DB_USER=your_database_user
FITTRACK_DB_PASSWORD=
# A username and a password of at least 16 characters are required online.
FITTRACK_ADMIN_USER=fittrack_owner
FITTRACK_ADMIN_PASSWORD=
# 127.0.0.1 allows access from this computer only. Docker uses 0.0.0.0 for hosting.
FITTRACK_BIND_HOST=127.0.0.1
# FITTRACK_PORT is used when set; otherwise the app uses PORT or its default.
FITTRACK_PORT=8080
